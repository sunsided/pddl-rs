{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // TypeScript 6 and later load no @types packages unless they are listed.
    "types": ["node"]
  },
  "include": ["src"]
}
