{
  "name": "pddl-lsp",
  "displayName": "PDDL (pddl-lsp)",
  "description": "PDDL language support through the pddl-lsp language server: diagnostics, navigation, completion, rename and formatting.",
  "version": "0.1.0",
  "publisher": "sunsided",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunsided/pddl-rs"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "pddl",
    "planning",
    "lsp"
  ],
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pddl",
        "aliases": [
          "PDDL",
          "pddl"
        ],
        "extensions": [
          ".pddl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pddl",
        "scopeName": "source.pddl",
        "path": "./syntaxes/pddl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PDDL",
      "properties": {
        "pddl.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a native `pddl-lsp` binary, such as `pddl-lsp` to look it up on `PATH`. If empty, the extension runs the WebAssembly build of the server it bundles."
        },
        "pddl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between VS Code and the language server to the output panel."
        }
      }
    },
    "commands": [
      {
        "command": "pddl.restartServer",
        "title": "PDDL: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --yarn --allow-missing-repository",
    "vscode:prepublish": "yarn run compile",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@vscode/wasm-wasi": "1.0.2",
    "@vscode/wasm-wasi-lsp": "0.1.0-pre.9",
    "vscode-languageclient": "10.0.0-next.21"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  },
  "packageManager": "yarn@1.22.22"
}
