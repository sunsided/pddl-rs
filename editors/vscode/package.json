{
  "name": "pddl-lsp",
  "displayName": "PDDL (pddl-lsp)",
  "description": "PDDL language support through the pddl-lsp language server: diagnostics, navigation, completion, rename and formatting.",
  "version": "0.2.0",
  "publisher": "sunsided",
  "preview": true,
  "license": "(EUPL-1.2 OR MPL-2.0)",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunsided/pddl-rs"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "pddl",
    "planning",
    "lsp"
  ],
  "extensionDependencies": [
    "ms-vscode.wasm-wasi-core"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, only syntax highlighting is available. The language server starts once you trust the folder, so an untrusted folder can't choose a program through `pddl.server.path`.",
      "restrictedConfigurations": [
        "pddl.server.path",
        "pddl.planner",
        "pddl.validator",
        "pddl.planningAsAService.url"
      ]
    }
  },
  "main": "./dist/extension.js",
  "browser": "./dist/browser.js",
  "contributes": {
    "languages": [
      {
        "id": "pddl",
        "aliases": [
          "PDDL",
          "pddl"
        ],
        "extensions": [
          ".pddl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pddl-plan",
        "aliases": [
          "PDDL Plan"
        ],
        "extensions": [
          ".plan"
        ],
        "filenames": [
          "sas_plan"
        ],
        "filenamePatterns": [
          "sas_plan.*"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pddl",
        "scopeName": "source.pddl",
        "path": "./syntaxes/pddl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.pddl.codeblock",
        "path": "./syntaxes/pddl.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pddl": "pddl"
        }
      },
      {
        "scopeName": "pddl.language-comment.rust",
        "path": "./syntaxes/pddl.rust-injection.tmLanguage.json",
        "injectTo": [
          "source.rust",
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pddl": "pddl"
        }
      },
      {
        "scopeName": "pddl.language-comment.javascript",
        "path": "./syntaxes/pddl.javascript-injection.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pddl": "pddl"
        }
      },
      {
        "scopeName": "pddl.language-comment.typescript",
        "path": "./syntaxes/pddl.typescript-injection.tmLanguage.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pddl": "pddl"
        }
      },
      {
        "scopeName": "pddl.language-comment.python",
        "path": "./syntaxes/pddl.python-injection.tmLanguage.json",
        "injectTo": [
          "source.python",
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.pddl": "pddl"
        }
      },
      {
        "language": "pddl-plan",
        "scopeName": "source.pddl.plan",
        "path": "./syntaxes/pddl-plan.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PDDL",
      "properties": {
        "pddl.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a native `pddl-lsp` binary, such as `pddl-lsp` to look it up on `PATH`. If empty, the extension runs the WebAssembly build of the server it bundles. A workspace can only set this once you trust it.",
          "scope": "machine-overridable"
        },
        "pddl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between VS Code and the language server to the output panel."
        },
        "pddl.planner": {
          "type": "string",
          "default": "lama-first",
          "markdownDescription": "The [planutils](https://pypi.org/project/planutils) planner that **PDDL: Solve with planutils** runs, such as `lama-first`, `lama` or `enhsp`. Install it with `planutils install <planner>`."
        },
        "pddl.validator": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Validate"
          ],
          "markdownDescription": "The command that runs [VAL](https://github.com/KCL-Planning/VAL) for **PDDL: Validate Plan with VAL**, as a program and its first arguments. The extension appends `-v <domain> <problem> <plan>`. With planutils (`planutils install val`), use `[\"val\", \"Validate\"]`."
        },
        "pddl.planningAsAService.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "A [Planning-as-a-Service](https://github.com/AI-Planning/planning-as-a-service) server, such as `http://localhost:5001` for one you run with `planutils install server-environment`. Empty (the default) turns **PDDL: Solve with Planning-as-a-Service** off. The command sends the full text of the domain and problem to this server, and asks before it does. Only user settings can set it, not a workspace."
        }
      }
    },
    "commands": [
      {
        "command": "pddl.restartServer",
        "title": "PDDL: Restart Language Server"
      },
      {
        "command": "pddl.solveWithPlanutils",
        "title": "PDDL: Solve with planutils",
        "enablement": "!isWeb"
      },
      {
        "command": "pddl.checkPlan",
        "title": "PDDL: Validate Plan"
      },
      {
        "command": "pddl.validatePlan",
        "title": "PDDL: Validate Plan with VAL",
        "enablement": "!isWeb"
      },
      {
        "command": "pddl.solveWithService",
        "title": "PDDL: Solve with Planning-as-a-Service"
      }
    ],
    "snippets": [
      {
        "language": "pddl",
        "path": "./snippets/pddl.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pddl.solveWithPlanutils",
          "when": "!isWeb && editorLangId == pddl"
        },
        {
          "command": "pddl.checkPlan",
          "when": "editorLangId == pddl-plan"
        },
        {
          "command": "pddl.validatePlan",
          "when": "!isWeb && editorLangId == pddl-plan"
        },
        {
          "command": "pddl.solveWithService",
          "when": "editorLangId == pddl"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "pddl-planutils",
        "required": [
          "planner"
        ],
        "properties": {
          "planner": {
            "type": "string",
            "description": "The planutils planner to run."
          }
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "compile": "yarn run typecheck && node esbuild.mjs",
    "compile:production": "yarn run typecheck && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/sunsided/pddl-rs/blob/main/editors/vscode --baseImagesUrl https://github.com/sunsided/pddl-rs/raw/main/editors/vscode",
    "vscode:prepublish": "yarn run compile:production",
    "test": "node test/run.js",
    "test:web": "node test/web.js"
  },
  "dependencies": {
    "@vscode/wasm-wasi": "1.0.2",
    "@vscode/wasm-wasi-lsp": "0.1.0-pre.9",
    "vscode-languageclient": "10.0.0-next.21"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "2.4.1",
    "@vscode/test-web": "0.0.81",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.1",
    "typescript": "5.6.3"
  },
  "packageManager": "yarn@1.22.22"
}
