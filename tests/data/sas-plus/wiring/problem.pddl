(define (problem wiring-lamp)
  (:domain wiring)
  (:objects plant junction shed lamp - node)
  (:init (source plant)
         (duct plant junction) (= (duct-length plant junction) 2)
         (duct junction lamp) (= (duct-length junction lamp) 2)
         (duct plant shed) (= (duct-length plant shed) 1)
         (duct shed lamp) (= (duct-length shed lamp) 4)
         (duct plant lamp) (= (duct-length plant lamp) 5)
         (= (total-cost) 0))
  (:goal (powered lamp))
  (:metric minimize (total-cost)))
