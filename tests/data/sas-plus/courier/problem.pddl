(define (problem courier-3)
  (:domain courier)
  (:objects depot north south - location parcel1 parcel2 - parcel)
  (:init (van-at depot) (at parcel1 depot) (at parcel2 north)
         (road depot north) (road north depot) (road north south)
         (road south north) (road depot south) (road south depot)
         (= (road-length depot north) 4) (= (road-length north depot) 4)
         (= (road-length north south) 2) (= (road-length south north) 2)
         (= (road-length depot south) 7) (= (road-length south depot) 7)
         (= (total-cost) 0))
  (:goal (and (at parcel1 south) (at parcel2 depot) (not (loaded parcel1)) (not (loaded parcel2))))
  (:metric minimize (total-cost)))
